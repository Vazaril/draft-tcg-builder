### ============================================================
### TESTDATEN
### ============================================================

@pokemonDeckId = e2d163fc-efc8-4aea-9255-b10db9594a5e
@magicDeckId = 57dcba51-61bc-4556-881a-a3e6ec82b44d

# Pokémon:
# ID aus pokemon_cards.id -> für Hinzufügen
@pokemonCardId = 9f2da581-bb19-43d2-b202-4eeda2fa29d7

# ID aus pokemon_deck_cards.id -> für Löschen
@pokemonDeckCardId = 34838c53-3398-45cc-94aa-9582b92ef6d8
@pokemonDeckCardId2 = 6f4f008b-63ac-4e50-afd3-94b3fd23e312

# Magic:
# mtg_cards.id
@magicCardId = 1cacc52b-9e52-42d3-a152-0c96ff55ab44
@magicCardId2 = 5819e3f3-da49-4003-88ce-f3b7bb495787


### 0. LOGIN
### ============================================================

# @name login
POST {{supabaseUrl}}/auth/v1/token?grant_type=password
apikey: {{supabaseAnonKey}}
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.global.set("token", response.body.access_token);
%}


### 1. ALLE DECKS
### ============================================================

GET {{baseUrl}}/api/decks
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(
      response.status === 200,
      "Erwartet 200, bekommen " + response.status
    );
  });

  client.test("Response ist ein Array", function () {
    client.assert(
      Array.isArray(response.body),
      "Response ist kein Array"
    );
  });
%}


### 2. POKÉMON DECK LADEN
### ============================================================

GET {{baseUrl}}/api/decks/{{pokemonDeckId}}
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Deck ist Pokémon", function () {
    client.assert(
      response.body.game_type === "pokemon",
      "Erwartet pokemon, bekommen " + response.body.game_type
    );
  });

  client.test("Cards ist ein Array", function () {
    client.assert(
      Array.isArray(response.body.cards),
      "cards ist kein Array"
    );
  });

  client.test("Pokémon-Karten besitzen benötigte Daten", function () {
    response.body.cards.forEach(function (entry) {
      client.assert(entry.id, "pokemon_deck_cards.id fehlt");
      client.assert(entry.card_id, "card_id fehlt");
      client.assert(entry.quantity > 0, "quantity ungültig");
      client.assert(entry.pokemon_cards, "pokemon_cards fehlt");
      client.assert(entry.pokemon_cards.name, "Kartenname fehlt");
    });
  });
%}


### 3. MAGIC DECK LADEN
### ============================================================

GET {{baseUrl}}/api/decks/{{magicDeckId}}
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Deck ist Magic", function () {
    client.assert(
      response.body.game_type === "magic",
      "Erwartet magic, bekommen " + response.body.game_type
    );
  });

  client.test("Cards ist ein Array", function () {
    client.assert(
      Array.isArray(response.body.cards),
      "cards ist kein Array"
    );
  });

  client.test("Magic-Karten besitzen benötigte Daten", function () {
    response.body.cards.forEach(function (entry) {
      client.assert(entry.card_id, "card_id fehlt");
      client.assert(entry.quantity > 0, "quantity ungültig");
      client.assert(entry.zone, "zone fehlt");
      client.assert(entry.mtg_cards, "mtg_cards fehlt");
      client.assert(entry.mtg_cards.name, "Kartenname fehlt");
    });
  });
%}


