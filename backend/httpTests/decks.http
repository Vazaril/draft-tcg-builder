### 7. POKÉMON-KARTE HINZUFÜGEN
### ============================================================

POST {{baseUrl}}/api/decks/{{pokemonDeckId}}/cards
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "card_id": "{{pokemonCardId}}",
  "quantity": 3,
  "position": 3,
  "reasoning": "Trainerkarte zur Unterstützung der Deckstrategie."
}

> {%
  client.test("Status ist 200 oder 201", function () {
    client.assert(
      response.status === 200 || response.status === 201,
      "Erwartet 200/201, bekommen " + response.status
    );
  });
%}



### 8. MAGIC-KARTE HINZUFÜGEN
### ============================================================

POST {{baseUrl}}/api/decks/{{magicDeckId}}/cards
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "card_id": "{{magicCardId}}",
  "quantity": 2,
  "zone": "mainboard"
}

> {%
  client.test("Status ist 200 oder 201", function () {
    client.assert(
      response.status === 200 || response.status === 201,
      "Erwartet 200/201, bekommen " + response.status
    );
  });

  client.test("Game-spezifische Magic-Daten vorhanden", function () {
    client.assert(response.body.card_id, "card_id fehlt");
    client.assert(response.body.quantity > 0, "quantity ungültig");
    client.assert(response.body.zone === "mainboard", "zone stimmt nicht");
    client.assert(response.body.mtg_cards, "mtg_cards fehlt");
  });
%}



### 9. POKÉMON: ANZAHL REDUZIEREN
### ============================================================

DELETE {{baseUrl}}/api/decks/{{pokemonDeckId}}/cards/{{pokemonDeckCardId}}?amount=1
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Game Type ist Pokémon", function () {
    client.assert(response.body.game_type === "pokemon");
  });
%}



### 10. MAGIC: ANZAHL REDUZIEREN
### ============================================================

DELETE {{baseUrl}}/api/decks/{{magicDeckId}}/cards/{{magicCardId}}?amount=1&zone=mainboard
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Game Type ist Magic", function () {
    client.assert(response.body.game_type === "magic");
  });
%}



### 11. POKÉMON: KARTE KOMPLETT LÖSCHEN
### ============================================================

DELETE {{baseUrl}}/api/decks/{{pokemonDeckId}}/cards/{{pokemonDeckCardId}}
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Karte wurde komplett gelöscht", function () {
    client.assert(response.body.deleted === true);
    client.assert(response.body.remaining_quantity === 0);
  });
%}



### 12. MAGIC: KARTE KOMPLETT LÖSCHEN
### ============================================================

DELETE {{baseUrl}}/api/decks/{{magicDeckId}}/cards/{{magicCardId}}?zone=mainboard
Authorization: Bearer {{token}}

> {%
  client.test("Status ist 200", function () {
    client.assert(response.status === 200);
  });

  client.test("Karte wurde komplett gelöscht", function () {
    client.assert(response.body.deleted === true);
    client.assert(response.body.remaining_quantity === 0);
  });
%}



### 13. POKÉMON BULK DELETE
### ============================================================

POST {{baseUrl}}/api/decks/{{pokemonDeckId}}/cards/bulk-delete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cards": [
    {
      "card_id": "{{pokemonDeckCardId}}",
      "amount": 1
    },
    {
      "card_id": "{{pokemonDeckCardId2}}",
      "amount": 1
    }
  ]
}

> {%
  client.test("Status ist 200", function () {
    client.assert(
      response.status === 200,
      "Erwartet 200, bekommen " + response.status
    );
  });

  client.test("Zwei Ergebnisse vorhanden", function () {
    client.assert(response.body.results.length === 2);
  });
%}



